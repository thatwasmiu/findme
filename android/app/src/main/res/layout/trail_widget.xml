<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget. Only views RemoteViews allows. The empty state is the preview in the widget picker. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trail_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/trail_widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/trail_widget_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/trail_widget_age"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="8dp"
        android:background="@drawable/trail_widget_chip"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="#3F2A3A"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- The map's licence requires this. A view, not in the picture: centerCrop cuts the picture's edges. -->
    <TextView
        android:id="@+id/trail_widget_credit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/trail_widget_chip"
        android:paddingHorizontal="4dp"
        android:text="© OpenStreetMap"
        android:textColor="#3F2A3A"
        android:textSize="8sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/trail_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_hachiware" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Chưa ghi hành trình"
            android:textColor="#9B7B92"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
