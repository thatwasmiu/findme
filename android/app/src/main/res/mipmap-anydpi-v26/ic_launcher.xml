<?xml version="1.0" encoding="utf-8"?>
<!-- Hachiware inside the launcher's mask: inset so the round frame is not cut by a circular mask. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white" />
    <foreground>
        <inset android:drawable="@drawable/ic_launcher_foreground" android:inset="10%" />
    </foreground>
</adaptive-icon>
